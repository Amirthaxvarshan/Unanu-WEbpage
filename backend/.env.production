# Production Environment Configuration
# UNANU Contact System - Production

# Environment
NODE_ENV=production
PORT=3000
LOG_LEVEL=warn

# Security Configuration
ENCRYPTION_KEY=GENERATE_NEW_32_BYTE_KEY_FOR_PRODUCTION
JWT_SECRET=GENERATE_NEW_JWT_SECRET_FOR_PRODUCTION
BCRYPT_ROUNDS=12
CORS_ORIGIN=https://unanu.com

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@your-production-db-host:5432/unanu_contacts_prod
DATABASE_SSL_MODE=require
DATABASE_POOL_MAX=20

# Redis Configuration (for rate limiting and caching)
RATE_LIMIT_REDIS_URL=redis://your-production-redis-host:6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Email Configuration (SendGrid or AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
FROM_EMAIL=noreply@unanu.com
FROM_NAME=UNANU Contact System
ADMIN_EMAILS=admin@unanu.com,sales@unanu.com,operations@unanu.com

# Content Security Policy
HELMET_CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self'

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=3

# Data Retention
DATA_RETENTION_DAYS=730
AUTO_CLEANUP_ENABLED=true

# reCAPTCHA (optional)
RECAPTCHA_SITE_KEY=your_production_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_production_recaptcha_secret_key

# Monitoring and Analytics
SENTRY_DSN=your_sentry_dsn_for_error_tracking
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# SSL/TLS
SSL_CERT_PATH=/etc/ssl/certs/unanu.crt
SSL_KEY_PATH=/etc/ssl/private/unanu.key

# Backup Configuration
BACKUP_S3_BUCKET=unanu-backups
BACKUP_S3_REGION=us-east-1
BACKUP_SCHEDULE=0 2 * * *

# Performance
CLUSTER_WORKERS=2
COMPRESSION_ENABLED=true
CACHE_TTL=300

# Security Headers
RATE_LIMIT_HEADERS=true
SECURITY_HEADERS=true