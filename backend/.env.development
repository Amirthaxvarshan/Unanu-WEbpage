# Development Environment Configuration
# UNANU Contact System - Development

# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Security Configuration (Development - DO NOT USE IN PRODUCTION)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=development_jwt_secret_key_not_for_production_use_only
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:5500

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/unanu_contacts_dev
DATABASE_SSL_MODE=prefer
DATABASE_POOL_MAX=5

# Redis Configuration (for rate limiting)
RATE_LIMIT_REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=1

# Email Configuration (Mailtrap for development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
FROM_EMAIL=noreply@unanu.dev
FROM_NAME=UNANU Contact System (Dev)
ADMIN_EMAILS=dev@unanu.com

# Content Security Policy (more relaxed for development)
HELMET_CSP_DIRECTIVES=default-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' ws: wss:

# Rate Limiting (more relaxed for development)
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_REQUESTS=10

# Data Retention
DATA_RETENTION_DAYS=30
AUTO_CLEANUP_ENABLED=true

# reCAPTCHA (optional - use test keys)
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEbUjQcWjMkqr7
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Development Tools
DEBUG=unanu:*
ENABLE_SWAGGER=true
ENABLE_CORS_DEBUG=true

# Mock Services (for testing without real services)
USE_MOCK_EMAIL=false
USE_MOCK_REDIS=false
SKIP_AUTH_FOR_DEV=false

# Performance (development settings)
CLUSTER_WORKERS=1
COMPRESSION_ENABLED=true
CACHE_TTL=60

# Security Headers (more relaxed for development)
RATE_LIMIT_HEADERS=true
SECURITY_HEADERS=true
CORS_CREDENTIALS=true