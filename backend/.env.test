# Test Environment Configuration
# UNANU Contact System - Testing

# Environment
NODE_ENV=test
PORT=3001
LOG_LEVEL=error

# Security Configuration (Test-only keys)
ENCRYPTION_KEY=test_key_32_characters_long_123456
JWT_SECRET=test_jwt_secret_for_testing_only
BCRYPT_ROUNDS=4
CORS_ORIGIN=http://localhost:3001

# Database Configuration (PostgreSQL Test Database)
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/unanu_contacts_test
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=2

# Redis Configuration (Test Redis Database)
RATE_LIMIT_REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=2

# Email Configuration (Mock for testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
FROM_EMAIL=test@unanu.test
FROM_NAME=UNANU Test System
ADMIN_EMAILS=test@unanu.test

# Content Security Policy (minimal for testing)
HELMET_CSP_DIRECTIVES=default-src 'self' 'unsafe-inline' 'unsafe-eval'

# Rate Limiting (disabled for testing)
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_REQUESTS=100

# Data Retention
DATA_RETENTION_DAYS=1
AUTO_CLEANUP_ENABLED=false

# reCAPTCHA (disabled for testing)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Testing Configuration
TEST_TIMEOUT=30000
TEST_PARALLEL=true
MOCK_EXTERNAL_SERVICES=true

# Performance (test settings)
CLUSTER_WORKERS=1
COMPRESSION_ENABLED=false
CACHE_TTL=1

# Security Headers (minimal for testing)
RATE_LIMIT_HEADERS=false
SECURITY_HEADERS=false

# Test Data
SEED_TEST_DATA=true
CLEANUP_AFTER_TESTS=true