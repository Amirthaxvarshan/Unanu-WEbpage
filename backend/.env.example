# Security Configuration
ENCRYPTION_KEY=your-32-byte-encryption-key-here
JWT_SECRET=your-jwt-secret-key-here
BCRYPT_ROUNDS=12
CORS_ORIGIN=https://unanu.com

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/unanu_contacts
DATABASE_SSL_MODE=require
DATABASE_POOL_MAX=20

# Redis Configuration (for rate limiting)
RATE_LIMIT_REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
FROM_EMAIL=noreply@unanu.com
FROM_NAME=UNANU Contact System
ADMIN_EMAILS=admin@unanu.com,sales@unanu.com

# reCAPTCHA (optional)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Application Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=3

# Security Headers
HELMET_CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self'"

# Data Retention
DATA_RETENTION_DAYS=730
AUTO_CLEANUP_ENABLED=true